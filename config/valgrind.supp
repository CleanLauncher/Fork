# Valgrind suppressions for known false positives from Qt and system libraries
# These are one-time global allocations cleaned up at process exit

# Qt QCoreApplication and QTEST_GUILESS_MAIN initialization
{
   Qt-core-init-definite
   Memcheck:Leak
   ...
   obj:*/libQt6Core.so*
}
{
   Qt-core-init-reachable
   Memcheck:Leak
   ...
   obj:*/libQt6Core.so*
}

# Qt GUI library initialization
{
   Qt-gui-init
   Memcheck:Leak
   ...
   obj:*/libQt6Gui.so*
}

# Qt XML parsing library
{
   Qt-xml-init
   Memcheck:Leak
   ...
   obj:*/libQt6Xml.so*
}

# Qt Network library
{
   Qt-network-init
   Memcheck:Leak
   ...
   obj:*/libQt6Network.so*
}

# Qt Test framework internal allocations
{
   Qt-test-internal
   Memcheck:Leak
   ...
   obj:*/libQt6Test.so*
}

# Qt widgets
{
   Qt-widgets-init
   Memcheck:Leak
   ...
   obj:*/libQt6Widgets.so*
}

# GLib main loop, thread system, and memory allocator
{
   GLib-allocations
   Memcheck:Leak
   ...
   obj:*/libglib-2.0.so*
}
{
   GLib-gthread
   Memcheck:Leak
   ...
   obj:*/libgthread-2.0.so*
}

# OpenSSL global initialization
{
   OpenSSL-init
   Memcheck:Leak
   ...
   obj:*/libssl.so*
}
{
   OpenSSL-crypto-init
   Memcheck:Leak
   ...
   obj:*/libcrypto.so*
}

# X11 display and input handling
{
   X11-allocations
   Memcheck:Leak
   ...
   obj:*/libX11.so*
}

# ICU unicode library
{
   ICU-init
   Memcheck:Leak
   ...
   obj:*/libicui18n.so*
}
{
   ICU-uc-init
   Memcheck:Leak
   ...
   obj:*/libicuuc.so*
}
{
   ICU-data-init
   Memcheck:Leak
   ...
   obj:*/libicudata.so*
}

# Fontconfig
{
   fontconfig-init
   Memcheck:Leak
   ...
   obj:*/libfontconfig.so*
}

# CTest process itself
{
   ctest-internal
   Memcheck:Leak
   ...
   obj:*/ctest
}

# libc internal allocations (thread-local storage, etc.)
{
   libc-internal
   Memcheck:Leak
   ...
   obj:*/libc.so*
}
